{
  "expo": {
    "name": "Skillzenapp",
    "slug": "Skillzenapp",
    "version": "1.0.0",
    "orientation": "portrait",
     "icon": "./assets/images/forgroundImage.png",
    "scheme": "skillzenapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/forgroundImage.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/forgroundImage.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.Skillzenapp",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-google-signin/google-signin",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}