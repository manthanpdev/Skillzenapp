{
  "expo": {
    "name": "Skillzenapp",
    "slug": "Skillzenapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "skillzenapp",
    "userInterfaceStyle": "automatic",

    "ios": {
      "icon": "./assets/images/forgroundImage.png"
    },

    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.Skillzenapp",
      "googleServicesFile": "./google-services.json"
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },

    "plugins": [
      "expo-router",
      "@react-native-google-signin/google-signin"
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}